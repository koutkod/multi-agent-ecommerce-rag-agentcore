# ─────────────────────────────────────────────────────────────────────────────
# Multi-Agent E-commerce RAG - environment variables
#
# Copy to .env and fill in. Never commit the real .env.
# Most AWS resource names are read from CloudFormation exports by config.py;
# only values that cannot be auto-discovered live here.
# ─────────────────────────────────────────────────────────────────────────────

AWS_REGION=us-east-1
PROJECT_NAME=udacity-agentcore

# Bedrock Knowledge Base IDs - one per policy domain (Phase 3)
RETURNS_KB_ID=
SHIPPING_KB_ID=
WARRANTY_KB_ID=

# Printed by: python src/agent_orchestrator.py deploy
AGENTCORE_RUNTIME_ARN=
GUARDRAIL_ID=
GUARDRAIL_VERSION=
